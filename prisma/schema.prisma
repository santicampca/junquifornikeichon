// Prisma schema — Plataforma de Torneos de Fútbol Amateur
// Motor: MongoDB Atlas (free tier). Mongo no tiene FKs a nivel de motor,
// así que Prisma las emula con relationMode = "prisma" (valida/cascadea
// desde el cliente en vez de con constraints del lado del server).

generator client {
  provider      = "prisma-client-js"
  // "native" genera el binario para donde corre el build; "rhel-openssl-3.0.x"
  // es el runtime real de las funciones serverless de Vercel. Sin este segundo
  // target, prisma generate igual corre bien en el build pero el engine que
  // termina empaquetado no sirve para donde la función se ejecuta.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ============================================================
// TORNEOS Y TEMPORADAS
// ============================================================

/// Un Torneo es el contenedor de más alto nivel (ej: "Liga de Amigos JMC").
/// Puede tener múltiples Temporadas a lo largo del tiempo.
model Tournament {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Reglamento en texto libre, editable por el admin (ver updateTournamentRulesAction
  /// en src/lib/actions.ts). Se muestra en la pestaña "Reglas" del torneo.
  rules String?

  /// Plantilla semanal y formato (ida/vuelta) elegidos al crear el torneo.
  /// El Clausura ya NO arma su calendario solo al crear el torneo (ver
  /// generateClausuraCalendarAction): el admin lo activa a mano cuando
  /// quiere, eligiendo la fecha de inicio, y ese momento reusa esta misma
  /// plantilla en vez de pedirla de nuevo.
  weeklySlots TournamentWeeklySlot[]
  doubleRound Boolean                @default(false)

  seasons          Season[]
  teams            Team[]
  teamAvailability TeamAvailability[]
}

type TournamentWeeklySlot {
  day           DayOfWeek
  matchesPerDay Int
}

/// Una Temporada agrupa las fases de competición de un mismo ciclo (ej: "2026").
model Season {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId String     @db.ObjectId
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  name      String // ej: "Temporada 2026"
  year      Int
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  stages CompetitionStage[]

  @@unique([tournamentId, year, name])
  @@index([tournamentId])
}

enum StageType {
  APERTURA
  CLAUSURA
  SUPERCOPA
  GENERAL // Tabla acumulada/general (suma de otras fases)
  PLAYOFFS // Eliminación directa top-8 sobre la Tabla General, generada a mano por el admin
  OTRO
}

enum StageFormat {
  ROUND_ROBIN_SINGLE // todos contra todos, una vuelta
  ROUND_ROBIN_DOUBLE // todos contra todos, ida y vuelta
  GROUP_STAGE
  KNOCKOUT
  DIRECT_MATCH // ida y vuelta / partido único entre 2 equipos (ej: Supercopa)
}

enum StageStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  FINISHED
}

/// Una Fase de Competición dentro de una temporada: Apertura, Clausura,
/// Supercopa o la Tabla General (acumulada). El tipo GENERAL no genera
/// partidos propios: agrega los puntos de las fases listadas en
/// `aggregatesFrom` (ver StageAggregation).
model CompetitionStage {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  seasonId String @db.ObjectId
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  name   String // ej: "Torneo Apertura 2026"
  type   StageType
  format StageFormat
  status StageStatus @default(DRAFT)

  startDate DateTime?
  endDate   DateTime?

  // Reglas de puntuación configurables por fase
  pointsForWin  Int @default(2)
  pointsForDraw Int @default(1)
  pointsForLoss Int @default(0)

  /// Modo de alineación de esta fase ("fútbol de plato"): PASIVO (con
  /// arquero) o ACTIVO (sin arquero, un defensa ocupa ese lugar). Null =
  /// todavía no se marcó. Cada equipo tiene una alineación titular fija por
  /// modo (ver TeamLineup); esta fase usa la que corresponda según este
  /// campo.
  lineupMode LineupMode?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants StageParticipant[]
  matchdays    Matchday[]
  matches      Match[]

  // Auto-relación: una fase GENERAL agrega los puntos de otras fases
  // (ej: General agrega Apertura + Clausura)
  aggregatesFrom StageAggregation[] @relation("ParentStage")
  aggregatedBy   StageAggregation[] @relation("ChildStage")

  @@index([seasonId])
}

/// Tabla puente que define qué fases alimentan a una fase GENERAL/acumulada.
model StageAggregation {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  parentStageId String @db.ObjectId // la fase GENERAL
  childStageId  String @db.ObjectId // la fase que aporta puntos (Apertura, Clausura, ...)
  weight        Float  @default(1) // por si a futuro se pondera distinto

  parentStage CompetitionStage @relation("ParentStage", fields: [parentStageId], references: [id], onDelete: Cascade)
  childStage  CompetitionStage @relation("ChildStage", fields: [childStageId], references: [id], onDelete: Cascade)

  @@unique([parentStageId, childStageId])
}

/// Inscripción de un equipo en una fase concreta (permite que no todos los
/// equipos del torneo jueguen todas las fases, ej: solo campeones en Supercopa).
model StageParticipant {
  id      String           @id @default(auto()) @map("_id") @db.ObjectId
  stageId String           @db.ObjectId
  stage   CompetitionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  teamId  String           @db.ObjectId
  team    Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  group String? // para fases de grupos (ej: "Grupo A")
  seed  Int? // cabeza de serie / orden de siembra

  /// Puntos sumados/restados a mano por el admin en esta fase (sanciones,
  /// bonos, correcciones). Se suman a los puntos ganados en cancha al
  /// calcular la tabla (ver src/lib/standings.ts).
  pointsAdjustment Int @default(0)

  @@unique([stageId, teamId])
  @@index([teamId])
}

// ============================================================
// EQUIPOS Y JUGADORES
// ============================================================

/// Equipo registrado en la plataforma. Pertenece a un Torneo (directorio
/// general) y puede participar en múltiples fases/temporadas de ese torneo.
model Team {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId String     @db.ObjectId
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  name         String
  shortName    String?
  slug         String
  logoUrl      String?
  managerName  String // "propietario/mánager"
  primaryColor String? // hex, para acentos de UI
  foundedYear  Int?

  /// Hash del PIN de 3 dígitos con el que el equipo/DT inicia sesión (ver
  /// loginTeamAction/setTeamPinAction en src/lib/actions.ts). Null = todavía
  /// no configuró su PIN.
  pinHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players           Player[]
  stageParticipants StageParticipant[]
  homeMatches       Match[]            @relation("HomeTeam")
  awayMatches       Match[]            @relation("AwayTeam")
  availability      TeamAvailability[]
  lineups           TeamLineup[]

  @@unique([tournamentId, slug])
  @@index([tournamentId])
}

/// Jugador de la plantilla de un equipo (módulo opcional / futuro).
model Player {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  teamId    String    @db.ObjectId
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  number    Int?
  position  String? // ej: "Portero", "Defensa", "Mediocampista", "Delantero"
  birthDate DateTime?
  /// Total de goles en la temporada. NO se edita a mano: lo arma
  /// finishMatchAction sorteando quién los metió cada vez que se cierra un
  /// partido (ver MatchGoal más abajo). Alimenta la pestaña "Goleadores".
  goals     Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([teamId])
}

/// Registra qué jugador se llevó (cuántos de) los goles de un partido
/// concreto, para poder deshacer la asignación limpiamente si el resultado
/// se corrige (ver undoMatchGoals/assignMatchGoals en src/lib/actions.ts) —
/// si no, corregir un marcador sumaría goles de más sobre los ya asignados.
model MatchGoal {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  matchId  String @db.ObjectId
  playerId String @db.ObjectId
  count    Int

  @@unique([matchId, playerId])
  @@index([matchId])
}

enum LineupMode {
  PASIVO // con arquero
  ACTIVO // sin arquero: un defensa ocupa ese lugar
}

/// Alineación titular fija de un equipo para un modo de juego (PASIVO o
/// ACTIVO). Se configura una sola vez desde el perfil del equipo y queda
/// ahí hasta que la cambien (no se rearma partido a partido). Un equipo
/// tiene a lo sumo una alineación por modo.
model TeamLineup {
  id     String     @id @default(auto()) @map("_id") @db.ObjectId
  teamId String     @db.ObjectId
  team   Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mode   LineupMode

  /// Ids de los jugadores titulares para este modo. PASIVO: 6 (exactamente
  /// 1 Portero). ACTIVO: 4 (0 Porteros, al menos 1 Defensa).
  playerIds String[] @db.ObjectId

  updatedAt DateTime @updatedAt

  @@unique([teamId, mode])
  @@index([teamId])
}

// ============================================================
// PALMARÉS: títulos históricos por equipo (Apertura/Clausura/Supercopa/
// Playoffs de un año concreto), gestionados a mano por el admin liviano
// (el mismo de assertAdmin en src/lib/actions.ts, no el panel /admin de
// noticias). Se identifica al equipo por slug/nombre (snapshot, no relación
// a Team): un torneo nuevo crea documentos Team nuevos aunque el equipo sea
// "el mismo" de siempre (ver persist-tournament.ts), así que atar esto a un
// Team._id concreto haría que el título "desaparezca" apenas se recrea el
// torneo. El perfil de un equipo (src/app/equipos/[slug]/page.tsx) filtra
// por su propio slug para mostrar su palmarés.
// ============================================================

model Champion {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  teamSlug  String
  teamName  String
  year      Int
  title     String // ej: "Apertura", "Clausura", "Supercopa", "Playoffs"
  createdAt DateTime @default(now())

  @@index([teamSlug])
}

// ============================================================
// PLAYLIST: canciones subidas por el admin (data URL base64, mismo enfoque
// que NewsPhoto.imageData/Match.proofImageData) para la pestaña "Playlist".
// ============================================================

model PlaylistTrack {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  audioData String
  createdAt DateTime @default(now())
}

// ============================================================
// PANEL DE NOTICIAS (/admin) — login real de usuario/clave, separado del
// nombre-admin liviano que usa el resto de la app (ver ADMIN_ALLOWLIST en
// src/lib/actions.ts). Acá el admin controla el banco de frases y fotos
// que se combinan al azar para armar el titular de cada resultado.
// ============================================================

/// Cuenta de administrador del panel de noticias. Se crea una sola vez
/// (bootstrap: solo funciona si todavía no existe ninguna) desde /admin.
model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum NewsCategory {
  BLOWOUT // goleada (diferencia >= 3)
  COMFORTABLE // victoria cómoda (diferencia == 2)
  NARROW // victoria ajustada (diferencia == 1)
  DRAW // empate
  FORFEIT // walkover / incomparecencia
}

/// Plantilla de titular para una categoría de resultado. Placeholders:
/// {W}/{L}/{WS}/{LS} (ganador/perdedor/goles) para BLOWOUT/COMFORTABLE/
/// NARROW/FORFEIT (FORFEIT no usa {WS}/{LS}), {A}/{B}/{S} para DRAW.
/// Si una categoría tiene al menos una fila acá, reemplaza por completo a
/// las plantillas por defecto de src/lib/headlines.ts para esa categoría.
model NewsPhrase {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  category  NewsCategory
  template  String
  createdAt DateTime     @default(now())

  photos NewsPhoto[]

  @@index([category])
}

/// Banco de fotos para las tarjetas de noticias, subidas por el admin
/// (data URL base64, mismo enfoque que Match.proofImageData). Cada foto se
/// afilia a una frase concreta (`phraseId`): cuando esa frase sale elegida
/// para un resultado, se usa una de sus fotos afiliadas (al azar,
/// determinístico por partido) en vez de una foto cualquiera del banco. Una
/// foto sin afiliar (`phraseId` null) queda en el pool general de reserva,
/// usado solo si la frase elegida no tiene ninguna foto propia. Si no hay
/// ninguna foto disponible ni afiliada ni de reserva, la tarjeta cae de
/// nuevo al comprobante real del partido.
model NewsPhoto {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  imageData String
  createdAt DateTime    @default(now())
  phraseId  String?     @db.ObjectId
  phrase    NewsPhrase? @relation(fields: [phraseId], references: [id], onDelete: SetNull)

  @@index([phraseId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Restricción de disponibilidad de un equipo dentro de un torneo:
/// qué días de la semana puede jugar (ej: solo jueves, domingo y lunes).
/// El generador de fixtures debe respetar esto al asignar partidos.
model TeamAvailability {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  teamId       String     @db.ObjectId
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournamentId String     @db.ObjectId
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  allowedDays DayOfWeek[] // días permitidos; vacío = sin restricción
  notes       String?

  @@unique([teamId, tournamentId])
}

// ============================================================
// CALENDARIO Y PARTIDOS
// ============================================================

/// Una Jornada agrupa los partidos de una misma fecha/ronda dentro de una fase.
/// Puede abarcar un rango de días (ej: de jueves a lunes).
model Matchday {
  id      String           @id @default(auto()) @map("_id") @db.ObjectId
  stageId String           @db.ObjectId
  stage   CompetitionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  number    Int // jornada 1, 2, 3...
  label     String? // ej: "Jornada 1"
  weekStart DateTime? // inicio del rango de días habilitado (ej: jueves)
  weekEnd   DateTime? // fin del rango (ej: lunes)

  matches Match[]

  @@unique([stageId, number])
  @@index([stageId])
}

enum MatchStatus {
  SCHEDULED
  LIVE // el admin abrió el acta y está cargando el partido en curso
  PLAYED
  POSTPONED
  CANCELLED
  WALKOVER // ganado por incomparecencia
}

/// Un partido entre dos equipos dentro de una fase (y opcionalmente una jornada).
model Match {
  id      String           @id @default(auto()) @map("_id") @db.ObjectId
  stageId String           @db.ObjectId
  stage   CompetitionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  matchdayId String?   @db.ObjectId
  matchday   Matchday? @relation(fields: [matchdayId], references: [id], onDelete: SetNull)

  homeTeamId String @db.ObjectId
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String @db.ObjectId
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  homeScore Int?
  awayScore Int?

  homeYellowCards Int @default(0)
  awayYellowCards Int @default(0)
  homeRedCards    Int @default(0)
  awayRedCards    Int @default(0)

  scheduledAt DateTime?
  dayOfWeek   DayOfWeek?
  venue       String?
  round       String? // ej: "Semifinal", "Final", "Vuelta"
  status      MatchStatus @default(SCHEDULED)

  /// True cuando este partido es el que cumple, dentro de su jornada, la
  /// regla del "partido dominical obligatorio": todo domingo debe tener al
  /// menos un partido de un equipo con disponibilidad restringida (ej: Alianza
  /// Lima o UD Europollas). Lo calcula el generador de fixtures
  /// (`scheduleMatchdays` en src/lib/fixtures.ts); es informativo, no se
  /// revalida en cada request.
  isMandatorySundayMatch Boolean @default(false)

  /// Foto de comprobante del resultado, guardada como data URL (base64) para
  /// no depender de un servicio externo de storage. Un partido no puede
  /// pasar a PLAYED sin esto salvo que se cierre como WALKOVER (forfeit),
  /// donde no hay nada que comprobar (ver finishMatchAction/markForfeitAction
  /// en src/lib/actions.ts).
  proofImageData String?

  /// True si este resultado se cerró como forfeit (incomparecencia) en vez
  /// de con comprobante de foto. Informativo para la UI.
  isForfeit Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([matchdayId])
}
